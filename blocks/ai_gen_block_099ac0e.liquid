{% doc %}
  @prompt
    An editorial style product card landing page in the theme of Daphne Blue 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-card-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-editorial-card__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background-color: {{ block.settings.background_color }};
    min-height: {{ block.settings.min_height }}px;
  }

  .ai-editorial-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    {% if block.settings.layout == 'image-right' %}
      order: 2;
    {% endif %}
  }

  .ai-editorial-card__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-card__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #F2EDE6;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 500px;
  }

  .ai-editorial-card__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
    opacity: 0.3;
  }

  .ai-editorial-card__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    {% if block.settings.layout == 'image-right' %}
      order: 1;
    {% endif %}
  }

  .ai-editorial-card__eyebrow-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.eyebrow_size }}px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 16px;
    font-weight: 400;
  }

  .ai-editorial-card__title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.1;
    color: {{ block.settings.title_color }};
    margin: 0 0 24px 0;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .ai-editorial-card__description-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    color: {{ block.settings.description_color }};
    margin-bottom: 32px;
  }

  .ai-editorial-card__price-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    margin-bottom: 24px;
    letter-spacing: 0.05em;
  }

  .ai-editorial-card__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 40px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-family: var(--font-heading-family);
    font-size: {{ block.settings.button_text_size }}px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-editorial-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-card__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .ai-editorial-card__image-wrapper-{{ ai_gen_id }} {
      order: 1 !important;
      min-height: 400px;
    }

    .ai-editorial-card__content-{{ ai_gen_id }} {
      order: 2 !important;
      padding: 40px 24px;
      text-align: center;
    }

    .ai-editorial-card__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-editorial-card__eyebrow-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.eyebrow_size }}px * 0.9);
    }

    .ai-editorial-card__description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.95);
    }
  }
{% endstyle %}

<editorial-product-card-{{ ai_gen_id }}
  class="ai-editorial-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-card__container-{{ ai_gen_id }}">
    <div class="ai-editorial-card__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product %}
        {% if block.settings.product.featured_image %}
          <img
            src="{{ block.settings.product.featured_image | image_url: width: 1200 }}"
            alt="{{ block.settings.product.featured_image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.product.featured_image.width }}"
            height="{{ block.settings.product.featured_image.height }}"
            class="ai-editorial-card__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-editorial-card__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      {% elsif block.settings.custom_image %}
        <img
          src="{{ block.settings.custom_image | image_url: width: 1200 }}"
          alt="{{ block.settings.custom_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.custom_image.width }}"
          height="{{ block.settings.custom_image.height }}"
          class="ai-editorial-card__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-editorial-card__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-editorial-card__content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-editorial-card__eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow }}
        </div>
      {% endif %}

      {% if block.settings.product %}
        <h2 class="ai-editorial-card__title-{{ ai_gen_id }}">
          {{ block.settings.product.title }}
        </h2>
      {% elsif block.settings.custom_title != blank %}
        <h2 class="ai-editorial-card__title-{{ ai_gen_id }}">
          {{ block.settings.custom_title }}
        </h2>
      {% endif %}

      {% if block.settings.product %}
        {% if block.settings.show_description and block.settings.product.description != blank %}
          <div class="ai-editorial-card__description-{{ ai_gen_id }}">
            {{ block.settings.product.description | strip_html | truncate: 200 }}
          </div>
        {% endif %}
      {% elsif block.settings.custom_description != blank %}
        <div class="ai-editorial-card__description-{{ ai_gen_id }}">
          {{ block.settings.custom_description }}
        </div>
      {% endif %}

      {% if block.settings.product and block.settings.show_price %}
        <div class="ai-editorial-card__price-{{ ai_gen_id }}">
          {{ block.settings.product.price | money }}
        </div>
      {% endif %}

      {% if block.settings.product %}
        <a
          href="{{ block.settings.product.url }}"
          class="ai-editorial-card__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% elsif block.settings.custom_link %}
        <a
          href="{{ block.settings.custom_link }}"
          class="ai-editorial-card__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</editorial-product-card-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialProductCard{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('editorial-product-card-{{ ai_gen_id }}', EditorialProductCard{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Editorial product card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "image-left",
          "label": "Left"
        },
        {
          "value": "image-right",
          "label": "Right"
        }
      ],
      "default": "image-left"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "header",
      "content": "Custom content"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom image"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title"
    },
    {
      "type": "textarea",
      "id": "custom_description",
      "label": "Custom description"
    },
    {
      "type": "url",
      "id": "custom_link",
      "label": "Custom link"
    },
    {
      "type": "header",
      "content": "Eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New arrival"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Color",
      "default": "#6FA9B8"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Size",
      "min": 24,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#2E2E2E"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Color",
      "default": "#2E2E2E"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color",
      "default": "#2E2E2E"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text",
      "default": "Shop now"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#2E2E2E"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#FAFAF8"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#2E2E2E"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Hover background",
      "default": "#6FA9B8"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#FAFAF8"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border color",
      "default": "#6FA9B8"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAFAF8"
    }
  ],
  "presets": [
    {
      "name": "Editorial product card"
    }
  ]
}
{% endschema %}

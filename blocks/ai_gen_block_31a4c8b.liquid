{% doc %}
  @prompt
    Add an editorial themed similar products section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-similar-products-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-similar-products__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-similar-products__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
    text-align: {{ block.settings.heading_alignment }};
  }

  .ai-similar-products__heading-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.heading_font }}-family);
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {% if block.settings.heading_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-similar-products__subheading-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-style: italic;
  }

  .ai-similar-products__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin-top: {{ block.settings.grid_top_spacing }}px;
  }

  .ai-similar-products__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease;
  }

  .ai-similar-products__item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .ai-similar-products__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-similar-products__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-similar-products__image-{{ ai_gen_id }}--secondary {
    opacity: 0;
  }

  .ai-similar-products__item-{{ ai_gen_id }}:hover .ai-similar-products__image-{{ ai_gen_id }}--secondary {
    opacity: {% if block.settings.show_second_image %}1{% else %}0{% endif %};
  }

  .ai-similar-products__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-similar-products__title-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.product_title_font }}-family);
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    letter-spacing: {{ block.settings.product_title_letter_spacing }}px;
    text-transform: {% if block.settings.product_title_uppercase %}uppercase{% else %}none{% endif %};
  }

  .ai-similar-products__title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ai-similar-products__title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-similar-products__price-{{ ai_gen_id }} {
    font-family: var(--font-{{ block.settings.price_font }}-family);
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    letter-spacing: 0.5px;
  }

  .ai-similar-products__price-compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-right: 8px;
  }

  .ai-similar-products__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-family: var(--font-body-family);
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-similar-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }

    .ai-similar-products__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-similar-products__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-similar-products__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.65);
    }

    .ai-similar-products-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }
{% endstyle %}

<editorial-similar-products-{{ ai_gen_id }} class="ai-similar-products-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-similar-products__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-similar-products__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-similar-products__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-similar-products__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-similar-products__grid-{{ ai_gen_id }}">
      {% if block.settings.product_list != blank %}
        {% for product in block.settings.product_list limit: block.settings.products_to_show %}
          <div class="ai-similar-products__item-{{ ai_gen_id }}">
            {% if product.compare_at_price > product.price and block.settings.show_sale_badge %}
              <div class="ai-similar-products__badge-{{ ai_gen_id }}">{{ block.settings.sale_badge_text }}</div>
            {% endif %}

            <div class="ai-similar-products__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  class="ai-similar-products__image-{{ ai_gen_id }}"
                >
                {% if product.images[1] and block.settings.show_second_image %}
                  <img
                    src="{{ product.images[1] | image_url: width: 800 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    loading="lazy"
                    width="800"
                    height="{{ 800 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                    class="ai-similar-products__image-{{ ai_gen_id }} ai-similar-products__image-{{ ai_gen_id }}--secondary"
                  >
                {% endif %}
              {% else %}
                <div class="ai-similar-products__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-similar-products__content-{{ ai_gen_id }}">
              <h3 class="ai-similar-products__title-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-similar-products__title-link-{{ ai_gen_id }}">
                  {{ product.title }}
                </a>
              </h3>

              <div class="ai-similar-products__price-{{ ai_gen_id }}">
                {% if product.compare_at_price > product.price %}
                  <span class="ai-similar-products__price-compare-{{ ai_gen_id }}">
                    {% render 'db-price-format', price_in_cents: product.compare_at_price %}
                  </span>
                {% endif %}
                <span>{% render 'db-price-format', price_in_cents: product.price %}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..block.settings.products_to_show) %}
          <div class="ai-similar-products__item-{{ ai_gen_id }}">
            <div class="ai-similar-products__image-wrapper-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
            <div class="ai-similar-products__content-{{ ai_gen_id }}">
              <h3 class="ai-similar-products__title-{{ ai_gen_id }}">
                <a href="#" class="ai-similar-products__title-link-{{ ai_gen_id }}">Product {{ i }}</a>
              </h3>
              <div class="ai-similar-products__price-{{ ai_gen_id }}">£0.00</div>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</editorial-similar-products-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialSimilarProducts{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.initLazyLoading();
      }

      initLazyLoading() {
        const images = this.querySelectorAll('.ai-similar-products__image-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const imageObserver = new IntersectionObserver(function(entries, observer) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                const img = entry.target;
                img.src = img.dataset.src || img.src;
                observer.unobserve(img);
              }
            });
          });

          images.forEach(function(img) {
            imageObserver.observe(img);
          });
        }
      }
    }

    customElements.define('editorial-similar-products-{{ ai_gen_id }}', EditorialSimilarProducts{{ ai_gen_id }});
  })();
</script>


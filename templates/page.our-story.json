          }
        },
        "s07_philosophy_split": {
          "type": "split",
          "settings": {
            "image_alt": "",
            "eyebrow": "The philosophy",
            "heading": "",
            "body": "<p>In a world full of noise, Daphne Blue is the pause.</p><p>We don't make jewellery for occasions. We make it for the life happening between them. The walk home. The deep breath. The moment you catch your reflection and actually like what you see.</p><p>Every piece is designed to be lived in. To age with you. To feel like yours from the first wear.</p>",
            "link_label": "",
            "link_url": "",
            "reverse": false
          }
        },
        "s08_quote_pause": {
